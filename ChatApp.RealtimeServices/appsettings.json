{
  "Urls": "http://0.0.0.0:8080",
  "Realtime": {
    "ServiceName": "ChatApp.RealtimeServices",
    "InstanceId": "local-dev",
    "WorkerIntervalMs": 1000,
    "EnableDetailedErrors": false,
    "ProcessingConcurrency": 4,
    "ProcessingQueueCapacity": 512,
    "HistoryQueryConcurrency": 8,
    "HistoryQueryQueueCapacity": 256,
    "HistoryQueryWorkerSlots": 2,
    "TransientRetryDelayMs": 1000,
    "PoisonDeliveryThreshold": 8,
    "ReadinessHeartbeatTimeoutMs": 30000
  },
  "Outbox": {
    "BatchSize": 100,
    "PublishConcurrency": 8,
    "PollIntervalMs": 200,
    "LeaseSeconds": 30,
    "MaxRetryDelaySeconds": 300,
    "MaxAttempts": 10,
    "PublishedRetentionHours": 168,
    "CleanupBatchSize": 500,
    "CleanupIntervalMs": 60000,
    "PublishedMaxBatchesPerCycle": 50,
    "PublishedBatchSleepMs": 100,
    "DeadRetentionDays": 30,
    "DeadMaxRows": 5000,
    "DeadArchiveSink": null
  },
  "SyncBootstrap": {
    "MaxCatchUpGapMs": 0,
    "RetentionHorizonMs": 0
  },
  "MessageRetention": {
    "Enabled": false,
    "RetentionHorizonMs": 0,
    "RetentionDays": 0,
    "BatchSize": 500,
    "IntervalMs": 60000,
    "BatchSleepMs": 100,
    "MaxBatchesPerCycle": 100
  },
  "Ops": {
    "ApiKey": ""
  },
  "Nats": {
    "Url": "nats://localhost:4222",
    "Mode": "JetStream",
    "QueueGroup": "chatapp-realtime-services",
    "Auth": {
      "Username": null,
      "Password": null,
      "Token": null,
      "CredsFile": null,
      "NKey": null,
      "Seed": null,
      "NKeyFile": null
    },
    "Trust": {
      "RequireGatewayIdentity": null,
      "UserIdHeader": "X-Chat-User-Id",
      "SessionIdHeader": "X-Chat-Session-Id"
    },
    "Routing": {
      "Mode": "Broadcast",
      "RealtimeEventsShardSubjectPattern": "chat.realtime-events.{0}",
      "ShardPublishParallelism": 4
    },
    "Subjects": {
      "IncomingMessages": "chat.incoming-messages",
      "MessageReceipts": "chat.message-receipts",
      "RealtimeEvents": "chat.realtime-events",
      "AccountCleanup": "chat.realtime-events.account-deleted",
      "MessageHistoryQueries": "chat.message-history.query",
      "ConversationListQueries": "chat.conversation-list.query",
      "ConversationMarkReads": "chat.conversation-mark-read",
      "ConversationSetPrefs": "chat.conversation-prefs.set",
      "MessageRecalls": "chat.message-recall",
      "MessageEdits": "chat.message-edit",
      "MessageReactions": "chat.message-reaction",
      "SyncBootstrapQueries": "chat.sync.bootstrap",
      "GroupConversations": "chat.group-conversation",
      "MessagePersistence": "chat.message-persistence",
      "DeadLetters": "chat.dead-letters"
    },
    "JetStream": {
      "Streams": {
        "IncomingMessages": "INCOMING_MESSAGES",
        "MessageReceipts": "MESSAGE_RECEIPTS",
        "RealtimeEvents": "REALTIME_EVENTS",
        "DeadLetters": "DEAD_LETTERS"
      },
      "Replicas": 1,
      "MaxBytes": 10737418240,
      "MaxMessageSize": 1048576,
      "MaxAgeHours": 168,
      "DeadLetterMaxAgeHours": 720,
      "DuplicateWindowMinutes": 10,
      "Consumer": {
        "AckWaitSeconds": 60,
        "MaxDeliver": 10,
        "MaxAckPending": 256,
        "BackoffSeconds": [1, 5, 30, 120, 300]
      }
    }
  },
  "MessageEdit": {
    "MaxAgeMinutes": 15
  },
  "MessageRecall": {
    "MaxAgeMinutes": 2
  },
  "MessageReaction": {
    "MaxDistinctEmojisPerMessage": 20,
    "MaxReactionsPerUserPerMessage": 20,
    "MaxEmojiLength": 32
  },
  "Observability": {
    "PrometheusEnabled": true,
    "PrometheusCacheMilliseconds": 300,
    "OutboxStatsCollectionIntervalMs": 300000,
    "OtlpEnabled": false,
    "OtlpEndpoint": "http://127.0.0.1:4317",
    "TraceSampleRatio": 0.05
  },
    "RealtimeDatabase": {
    "Schema": "realtime",
    // 生产必须为 Npgsql。EfCore 仅 Development/Testing：不绑定附件，回执/删除语义不完整。
    "MessageStoreProvider": "Npgsql",
    "InitializeSchemaOnStart": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  }
}
